{
  "sourceDir": "media-src",
  "outputDir": "public/media",
  "publicPrefix": "/media",
  "manifest": "media-manifest.json",
  "runtimeMap": "src/data/media-variants.json",
  "minSaving": 0.15,
  "webp": {
    "quality": 78,
    "qualityByProject": {
      "xana": 80
    },
    "fallbackQuality": 90,
    "effort": 6,
    "maxWidth": {
      "content": 2880,
      "hero": 2880,
      "heroMobile": 2880,
      "thumbnail": 2880
    },
    "widths": [
      480,
      800,
      1024,
      1440,
      1920
    ],
    "maxMeanError": 4,
    "maxFallbackRatio": 0.8
  },
  "svg": {
    "renderWidth": 1200,
    "pixelTolerance": 32,
    "maxDifferentPixels": 0.001,
    "maxMeanError": 0.5
  },
  "video": {
    "crf": 26,
    "preset": "slow",
    "maxWidth": 1440,
    "maxFps": 30,
    "poster": true,
    "posterTime": 0
  },
  "limits": {
    "warnBytes": 8388608,
    "maxBytes": 26214400
  },
  "content": [
    "src/data/projects.json",
    "src/data/about.json",
    "src/data/content"
  ]
}